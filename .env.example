# Copy to .env and fill in values.
# Config order:
# 1) Required wallet/base bot settings
# 2) BTC 5m common settings shared by live strategies
# 3) Strategy-specific settings
# 4) Research tools: backtest and collector

# =============================================================================
# 1. Required wallet / Polymarket base config
# =============================================================================

WALLET_PRIVATE_KEY=

# Wallet signature type: eoa | proxy | gnosis
SIG_TYPE=eoa
PROXY_WALLET_ADDRESS=

# General Polymarket / Polygon defaults
# DEBUG=false
# CHAIN_ID=137
# CLOB_API_URL=https://clob.polymarket.com
# NEG_RISK=false
# Set true only if USDC allowance has already been approved.
# Otherwise the bot needs a small amount of POL/MATIC gas to approve allowance.
SKIP_ALLOWANCE_APPROVE=false

# Balance gate used by live trading scripts
# BOT_MIN_USDC_BALANCE=1

# Logging
# LOG_DIR=logs
# LOG_FILE_PREFIX=bot
# LOG_FILE_PATH=

# Existing multi-market copytrade bot
COPYTRADE_MARKETS=btc
COPYTRADE_SHARES=5
COPYTRADE_TICK_SIZE=0.01
# COPYTRADE_NEG_RISK=false
# COPYTRADE_PRICE_BUFFER=0
# COPYTRADE_FIRE_AND_FORGET=true
# COPYTRADE_MIN_BALANCE_USDC=1
COPYTRADE_MAX_BUY_COUNTS_PER_SIDE=2
# COPYTRADE_WAIT_FOR_NEXT_MARKET_START=false

# Redeem script only
# CONDITION_ID=
# INDEX_SETS=

# =============================================================================
# 2. BTC 5m live common config
# =============================================================================
# These are shared defaults for btc5m:edge, btc5m:hybrid, btc5m:range-arb,
# and btc5m:market-maker. A strategy can still override any common setting with
# its own prefixed variable, e.g. EDGE_INTERVAL_MINUTES or MM_TICK_SIZE.

BTC5M_MARKET=btc
BTC5M_INTERVAL_MINUTES=5
BTC5M_TICK_SIZE=0.01
BTC5M_NEG_RISK=false
BTC5M_MIN_SECONDS_LEFT_TO_TRADE=30
BTC5M_CANCEL_SECONDS_BEFORE_END=5
BTC5M_BTC_PRICE_REFRESH_MS=1000
BTC5M_BTC_PRICE_MAX_STALE_MS=10000

# =============================================================================
# 3. BTC 5m strategy-specific config
# =============================================================================

# --- Edge Strategy: npm run btc5m:edge ---
EDGE_DRY_RUN=false                    # Set true to simulate without posting orders
EDGE_VOL_PER_INTERVAL=0.0020          # Conservative 8h sample setting
EDGE_MIN_EDGE=0.15                    # Requires fairProbability - askPrice >= 15%
EDGE_MIN_MOVE_BPS=0                   # 0 disables BTC move filter
EDGE_MIN_ELAPSED_SECONDS=0            # 0 disables cycle-start delay filter
EDGE_ORDER_USDC=3                     # USDC per signal
EDGE_MAX_USDC_PER_LEG=5               # Max USDC per UP/DOWN leg per cycle
EDGE_MAX_PRICE=0.85                   # Do not buy asks above this price
EDGE_RECORD_ENABLED=true              # Record decisions/orders for later optimization
EDGE_RECORD_FILE=data/btc5m-edge-live.csv
# Optional common overrides:
# EDGE_MARKET=btc
# EDGE_INTERVAL_MINUTES=5
# EDGE_TICK_SIZE=0.01
# EDGE_NEG_RISK=false
# EDGE_MIN_SECONDS_LEFT_TO_TRADE=30
# EDGE_CANCEL_SECONDS_BEFORE_END=5
# EDGE_BTC_PRICE_REFRESH_MS=1000
# EDGE_BTC_PRICE_MAX_STALE_MS=10000

# --- Managed-Edge Strategy: npm run btc5m:managed-edge ---
MANAGED_EDGE_DRY_RUN=true
MANAGED_EDGE_VOL_PER_INTERVAL=0.0015
MANAGED_EDGE_MIN_EDGE=0.25
MANAGED_EDGE_MIN_MOVE_BPS=0
MANAGED_EDGE_MIN_ELAPSED_SECONDS=0
MANAGED_EDGE_ORDER_USDC=3
MANAGED_EDGE_MAX_USDC_PER_LEG=5
MANAGED_EDGE_MAX_PRICE=0.85
MANAGED_EDGE_MIN_SECONDS_LEFT_TO_OPEN=60
MANAGED_EDGE_MAX_SECONDS_LEFT_TO_OPEN=240
MANAGED_EDGE_NO_CHEAP_BUY_SECONDS_LEFT=90
MANAGED_EDGE_MIN_CHEAP_PRICE=0.20
MANAGED_EDGE_MIN_ENTRY_PRICE=0.15
MANAGED_EDGE_TAKE_PROFIT_PCT=0.20
MANAGED_EDGE_TAKE_PROFIT_SELL_RATIO=0.50
MANAGED_EDGE_STOP_LOSS_PCT=0.30
MANAGED_EDGE_FORCE_EXIT_SECONDS_LEFT=30
MANAGED_EDGE_MIN_EXIT_PRICE=0.05
MANAGED_EDGE_RECORD_ENABLED=true
MANAGED_EDGE_RECORD_FILE=data/btc5m-managed-edge-live.csv
# Optional common overrides:
# MANAGED_EDGE_MARKET=btc
# MANAGED_EDGE_INTERVAL_MINUTES=5
# MANAGED_EDGE_TICK_SIZE=0.01
# MANAGED_EDGE_NEG_RISK=false
# MANAGED_EDGE_MIN_SECONDS_LEFT_TO_TRADE=30
# MANAGED_EDGE_CANCEL_SECONDS_BEFORE_END=5
# MANAGED_EDGE_BTC_PRICE_REFRESH_MS=1000
# MANAGED_EDGE_BTC_PRICE_MAX_STALE_MS=10000

# --- Adaptive-Edge Backtest Strategy ---
# Regime switching: trending edge + oscillating scalp + panic-discount buy.
ADAPTIVE_EDGE_LOOKBACK_SECONDS=60
ADAPTIVE_EDGE_MIN_HISTORY_POINTS=8
ADAPTIVE_EDGE_OSC_CROSS_COUNT=2
ADAPTIVE_EDGE_OSC_CHOPPINESS=3
ADAPTIVE_EDGE_OSC_MAX_BTC_MOVE_BPS=8
ADAPTIVE_EDGE_TREND_MIN_BTC_MOVE_BPS=10
ADAPTIVE_EDGE_TREND_MAX_CHOPPINESS=4
ADAPTIVE_EDGE_PANIC_MAX_BTC_MOVE_BPS=5
ADAPTIVE_EDGE_PANIC_MIN_DISCOUNT=0.10
ADAPTIVE_EDGE_PANIC_MIN_ASK=0.15
ADAPTIVE_EDGE_PANIC_MAX_ASK=0.45
ADAPTIVE_EDGE_UNDERVALUE_SCORE_THRESHOLD=0.20
ADAPTIVE_EDGE_MAX_REQUIRED_SIGMA=1.20
ADAPTIVE_EDGE_MOMENTUM_MIN_BPS=2
ADAPTIVE_EDGE_FAIR_MARKET_WEIGHT=0.35
ADAPTIVE_EDGE_FAIR_ASK_WEIGHT=0.20
ADAPTIVE_EDGE_PERCENTILE_WEIGHT=0.04
ADAPTIVE_EDGE_MOMENTUM_DIVERGENCE_BONUS=0.04
ADAPTIVE_EDGE_PANIC_DISCOUNT_BONUS=0.03
ADAPTIVE_EDGE_REQUIRED_SIGMA_PENALTY=0.10
ADAPTIVE_EDGE_LATE_TIME_PENALTY=0.05
ADAPTIVE_EDGE_SCALP_PROFIT_PRICE=0.10
ADAPTIVE_EDGE_SCALP_PROFIT_PCT=0.25

# --- Trend-Pullback Strategy: npm run btc5m:trend-pullback ---
# After either leg reaches the trigger, keep a lower BUY limit open until the cycle ends.
TREND_PULLBACK_DRY_RUN=true
TREND_PULLBACK_TRIGGER_PRICE=0.85
TREND_PULLBACK_ENTRY_PRICE=0.80
TREND_PULLBACK_ORDER_USDC=1.6
TREND_PULLBACK_MAX_USDC_PER_LEG=1.6
TREND_PULLBACK_MIN_SECONDS_LEFT_TO_TRIGGER=30
TREND_PULLBACK_MIN_SECONDS_LEFT_TO_FILL=0
TREND_PULLBACK_TRIGGER_CONFIRM_SECONDS=0
TREND_PULLBACK_MAX_ORDER_AGE_SECONDS=8
TREND_PULLBACK_MAX_BTC_REVERSAL_BPS=2
TREND_PULLBACK_POST_FILL_STOP_LOSS_PRICE=0
TREND_PULLBACK_POST_FILL_TAKE_PROFIT_PRICE=0
TREND_PULLBACK_POST_FILL_MAX_BTC_REVERSAL_BPS=0
TREND_PULLBACK_EVALUATION_INTERVAL_MS=1000
TREND_PULLBACK_ORDER_POLL_INTERVAL_MS=2000
TREND_PULLBACK_RECORD_ENABLED=true
TREND_PULLBACK_RECORD_FILE=data/btc5m-trend-pullback-live.csv

# --- Sustained-High Backtest Strategy ---
# A leg must stay at or above 0.90 for 10 seconds, then a 0.90 BUY limit remains open.
SUSTAINED_HIGH_TRIGGER_PRICE=0.90
SUSTAINED_HIGH_CONFIRM_SECONDS=10
SUSTAINED_HIGH_ENTRY_PRICE=0.90
SUSTAINED_HIGH_ORDER_USDC=4.50
SUSTAINED_HIGH_MAX_SECONDS_LEFT_TO_TRIGGER=120
SUSTAINED_HIGH_MIN_SECONDS_LEFT_TO_TRIGGER=20
SUSTAINED_HIGH_MIN_SECONDS_LEFT_TO_FILL=20
# 0 keeps the order open until the cycle ends.
SUSTAINED_HIGH_MAX_ORDER_AGE_SECONDS=0
SUSTAINED_HIGH_MIN_BTC_MOVE_BPS=3
SUSTAINED_HIGH_MAX_BTC_REVERSAL_BPS=2

# --- Latency Scalp Strategy: npm run btc5m:latency-scalp ---
# Safe default. Switch to false only after reviewing millisecond dry-run behavior.
LATENCY_SCALP_DRY_RUN=true
# Enter only when the winning leg rises through 0.72-0.75 with short-term momentum.
LATENCY_SCALP_MIN_SIGNAL_PRICE=0.72
LATENCY_SCALP_ENTRY_PRICE=0.75
LATENCY_SCALP_TAKE_PROFIT_PRICE=0.80
LATENCY_SCALP_ORDER_USDC=3.75
LATENCY_SCALP_TRIGGER_CONFIRM_SECONDS=2
LATENCY_SCALP_SIGNAL_LOOKBACK_SECONDS=5
LATENCY_SCALP_MIN_CONTRACT_MOMENTUM=0.03
LATENCY_SCALP_MIN_BTC_MOMENTUM_BPS=0
LATENCY_SCALP_MIN_BTC_MOVE_BPS=3
LATENCY_SCALP_MAX_SECONDS_LEFT_TO_TRIGGER=180
LATENCY_SCALP_MIN_SECONDS_LEFT_TO_TRIGGER=45
LATENCY_SCALP_MAX_ENTRY_ORDER_AGE_SECONDS=15
LATENCY_SCALP_MAX_HOLD_SECONDS=30
LATENCY_SCALP_MAX_BTC_REVERSAL_BPS=3
LATENCY_SCALP_STOP_LOSS_PRICE=0.70
LATENCY_SCALP_FORCE_EXIT_SECONDS_LEFT=20
# Strategy evaluates quickly; console and trajectory snapshots remain throttled.
LATENCY_SCALP_EVALUATION_INTERVAL_MS=100
LATENCY_SCALP_ORDER_POLL_INTERVAL_MS=250
LATENCY_SCALP_MARKET_LOG_INTERVAL_MS=1000
LATENCY_SCALP_RECORD_INTERVAL_MS=1000
LATENCY_SCALP_RECORD_ENABLED=true
LATENCY_SCALP_RECORD_FILE=data/btc5m-latency-scalp-live.csv
# Optional common overrides:
# LATENCY_SCALP_MARKET=btc
# LATENCY_SCALP_INTERVAL_MINUTES=5
# LATENCY_SCALP_TICK_SIZE=0.01
# LATENCY_SCALP_NEG_RISK=false
# LATENCY_SCALP_BTC_PRICE_REFRESH_MS=250
# LATENCY_SCALP_BTC_PRICE_MAX_STALE_MS=10000
# LATENCY_SCALP_BTC_PRICE_URLS=https://...

# --- Deep Rebound Strategy: npm run btc5m:deep-rebound ---
# Buys only deeply discounted contracts that pass the independent undervalue score.
DEEP_REBOUND_DRY_RUN=true
DEEP_REBOUND_MIN_ENTRY_PRICE=0.03
DEEP_REBOUND_MAX_ENTRY_PRICE=0.10
# At 0.10 this buys exactly the current CLOB minimum of 5 shares.
# Marketable BUY orders require at least 1 USDC; 1.01 leaves rounding headroom.
DEEP_REBOUND_ORDER_USDC=1.01
DEEP_REBOUND_MAX_USDC_PER_LEG=1.01
DEEP_REBOUND_SCORE_THRESHOLD=0.20
DEEP_REBOUND_MIN_DISCOUNT=0.05
# Absolute contract-price increase, e.g. 0.10 -> 0.15.
DEEP_REBOUND_TAKE_PROFIT_PRICE=0.05
DEEP_REBOUND_STOP_LOSS_PCT=0.50
DEEP_REBOUND_MIN_SECONDS_LEFT_TO_OPEN=60
DEEP_REBOUND_MAX_SECONDS_LEFT_TO_OPEN=240
DEEP_REBOUND_FORCE_EXIT_SECONDS_LEFT=30
DEEP_REBOUND_VOL_PER_INTERVAL=0.0015
DEEP_REBOUND_EVALUATION_INTERVAL_MS=250
DEEP_REBOUND_ORDER_POLL_INTERVAL_MS=500
DEEP_REBOUND_MARKET_LOG_INTERVAL_MS=1000
DEEP_REBOUND_RECORD_INTERVAL_MS=1000
DEEP_REBOUND_RECORD_ENABLED=true
DEEP_REBOUND_RECORD_FILE=data/btc5m-deep-rebound-live.csv
# Optional common overrides:
# DEEP_REBOUND_MARKET=btc
# DEEP_REBOUND_INTERVAL_MINUTES=5
# DEEP_REBOUND_TICK_SIZE=0.01
# DEEP_REBOUND_NEG_RISK=false
# DEEP_REBOUND_BTC_PRICE_REFRESH_MS=250
# DEEP_REBOUND_BTC_PRICE_MAX_STALE_MS=10000
# DEEP_REBOUND_BTC_PRICE_URLS=https://...

# --- Trend/Range Failure-Switch Backtest Strategy ---
# Starts with trend-pullback and switches modes after consecutive losing traded cycles.
TREND_RANGE_SWITCH_FAILURES=2

# --- Previous-Cycle Trend/Range Regime Backtest Strategy ---
# If the previous cycle was sufficiently oscillating, the next cycle uses range-arb.
TREND_RANGE_REGIME_BAND_LOWER=0.30
TREND_RANGE_REGIME_BAND_UPPER=0.70
TREND_RANGE_REGIME_MIN_BAND_RATIO=0.70
TREND_RANGE_REGIME_CENTER_BUFFER=0.05
TREND_RANGE_REGIME_MIN_CROSS_COUNT=3
TREND_RANGE_REGIME_MIN_PRICE_RANGE=0.15
TREND_RANGE_REGIME_MIN_CHOPPINESS=3
TREND_RANGE_REGIME_IGNORE_FINAL_SECONDS=60
TREND_RANGE_REGIME_MIN_SAMPLES=30
TREND_RANGE_REGIME_RANGE_PRICE=0.40
TREND_RANGE_REGIME_RANGE_USDC_PER_LEG=0.80

# --- Trend-Always-On + Conditional Range Overlay Strategy ---
# Safe default: simulate orders. Set false only after reviewing dry-run records.
TREND_RANGE_OVERLAY_DRY_RUN=true
# Trend-pullback runs every cycle.
TREND_RANGE_OVERLAY_TREND_TRIGGER_PRICE=0.85
TREND_RANGE_OVERLAY_TREND_ENTRY_PRICE=0.80
TREND_RANGE_OVERLAY_TREND_ORDER_USDC=4.00
TREND_RANGE_OVERLAY_TREND_MAX_USDC_PER_LEG=4.00
TREND_RANGE_OVERLAY_TREND_MIN_SECONDS_LEFT_TO_TRIGGER=30
TREND_RANGE_OVERLAY_TREND_MIN_SECONDS_LEFT_TO_FILL=0
TREND_RANGE_OVERLAY_TREND_CONFIRM_SECONDS=0
TREND_RANGE_OVERLAY_TREND_MAX_ORDER_AGE_SECONDS=8
TREND_RANGE_OVERLAY_TREND_MAX_BTC_REVERSAL_BPS=2
TREND_RANGE_OVERLAY_TREND_STOP_LOSS_PRICE=0
TREND_RANGE_OVERLAY_TREND_POST_FILL_MAX_BTC_REVERSAL_BPS=0
# Range orders are enabled only when the previous completed cycle was oscillating.
TREND_RANGE_OVERLAY_RANGE_FIRST_PRICE=0.40
TREND_RANGE_OVERLAY_RANGE_SECOND_PRICE=0.40
TREND_RANGE_OVERLAY_RANGE_MAX_TOTAL_USDC=4.00
# Optional take-profit applied to trend fills only in range-signaled cycles; 0 disables it.
TREND_RANGE_OVERLAY_TREND_TAKE_PROFIT_PRICE=0
# High-confidence fallback runs only in non-range cycles after trend-pullback expires unfilled.
TREND_RANGE_OVERLAY_HIGH_ENABLED=true
TREND_RANGE_OVERLAY_HIGH_TRIGGER_PRICE=0.90
TREND_RANGE_OVERLAY_HIGH_CONFIRM_SECONDS=10
TREND_RANGE_OVERLAY_HIGH_ENTRY_PRICE=0.90
# 5 shares at 0.90, matching the current CLOB minimum.
TREND_RANGE_OVERLAY_HIGH_ORDER_USDC=4.50
TREND_RANGE_OVERLAY_HIGH_MAX_SECONDS_LEFT_TO_TRIGGER=120
TREND_RANGE_OVERLAY_HIGH_MIN_SECONDS_LEFT_TO_TRIGGER=20
TREND_RANGE_OVERLAY_HIGH_MIN_SECONDS_LEFT_TO_FILL=20
# 0 keeps the order alive inside the guarded time window.
TREND_RANGE_OVERLAY_HIGH_MAX_ORDER_AGE_SECONDS=0
TREND_RANGE_OVERLAY_HIGH_MIN_BTC_MOVE_BPS=3
TREND_RANGE_OVERLAY_HIGH_MAX_BTC_REVERSAL_BPS=2
TREND_RANGE_OVERLAY_CANCEL_SECONDS_BEFORE_END=5
TREND_RANGE_OVERLAY_EVALUATION_INTERVAL_MS=1000
TREND_RANGE_OVERLAY_ORDER_POLL_INTERVAL_MS=2000
TREND_RANGE_OVERLAY_MARKET_LOG_INTERVAL_MS=1000
TREND_RANGE_OVERLAY_ORDER_RETRY_SECONDS=5
TREND_RANGE_OVERLAY_MARKET_DATA_STALE_SECONDS=30
TREND_RANGE_OVERLAY_RECORD_ENABLED=true
TREND_RANGE_OVERLAY_RECORD_FILE=data/btc5m-trend-range-overlay-live.csv
# Optional common overrides:
# TREND_RANGE_OVERLAY_MARKET=btc
# TREND_RANGE_OVERLAY_INTERVAL_MINUTES=5
# TREND_RANGE_OVERLAY_TICK_SIZE=0.01
# TREND_RANGE_OVERLAY_NEG_RISK=false
# TREND_RANGE_OVERLAY_BTC_PRICE_REFRESH_MS=1000
# TREND_RANGE_OVERLAY_BTC_PRICE_MAX_STALE_MS=10000
# TREND_RANGE_OVERLAY_BTC_PRICE_URLS=https://api.exchange.coinbase.com/products/BTC-USD/ticker|https://api.kraken.com/0/public/Ticker?pair=XBTUSD

# --- Adaptive Overlay Strategy: npm run btc5m:adaptive-overlay ---
# Runs trend/range/high plus an independent deep-rebound sleeve in every cycle.
ADAPTIVE_OVERLAY_DRY_RUN=true
ADAPTIVE_OVERLAY_TREND_TRIGGER_PRICE=0.85
ADAPTIVE_OVERLAY_TREND_ENTRY_PRICE=0.80
ADAPTIVE_OVERLAY_TREND_ORDER_USDC=4.00
ADAPTIVE_OVERLAY_TREND_MAX_USDC_PER_LEG=4.00
ADAPTIVE_OVERLAY_TREND_MIN_SECONDS_LEFT_TO_TRIGGER=30
ADAPTIVE_OVERLAY_TREND_MIN_SECONDS_LEFT_TO_FILL=0
ADAPTIVE_OVERLAY_TREND_CONFIRM_SECONDS=0
ADAPTIVE_OVERLAY_TREND_MAX_ORDER_AGE_SECONDS=8
ADAPTIVE_OVERLAY_TREND_MAX_BTC_REVERSAL_BPS=2
ADAPTIVE_OVERLAY_TREND_STOP_LOSS_PRICE=0
ADAPTIVE_OVERLAY_TREND_POST_FILL_MAX_BTC_REVERSAL_BPS=0
ADAPTIVE_OVERLAY_TREND_TAKE_PROFIT_PRICE=0
ADAPTIVE_OVERLAY_RANGE_FIRST_PRICE=0.40
ADAPTIVE_OVERLAY_RANGE_SECOND_PRICE=0.40
ADAPTIVE_OVERLAY_RANGE_MAX_TOTAL_USDC=4.00
ADAPTIVE_OVERLAY_REGIME_BAND_LOWER=0.30
ADAPTIVE_OVERLAY_REGIME_BAND_UPPER=0.70
ADAPTIVE_OVERLAY_REGIME_MIN_BAND_RATIO=0.70
ADAPTIVE_OVERLAY_REGIME_CENTER_BUFFER=0.05
ADAPTIVE_OVERLAY_REGIME_MIN_CROSS_COUNT=3
ADAPTIVE_OVERLAY_REGIME_MIN_PRICE_RANGE=0.15
ADAPTIVE_OVERLAY_REGIME_MIN_CHOPPINESS=3
ADAPTIVE_OVERLAY_REGIME_IGNORE_FINAL_SECONDS=60
ADAPTIVE_OVERLAY_REGIME_MIN_SAMPLES=30
ADAPTIVE_OVERLAY_HIGH_ENABLED=true
ADAPTIVE_OVERLAY_HIGH_TRIGGER_PRICE=0.90
ADAPTIVE_OVERLAY_HIGH_CONFIRM_SECONDS=10
ADAPTIVE_OVERLAY_HIGH_ENTRY_PRICE=0.90
ADAPTIVE_OVERLAY_HIGH_ORDER_USDC=4.50
ADAPTIVE_OVERLAY_HIGH_MAX_SECONDS_LEFT_TO_TRIGGER=120
ADAPTIVE_OVERLAY_HIGH_MIN_SECONDS_LEFT_TO_TRIGGER=20
ADAPTIVE_OVERLAY_HIGH_MIN_SECONDS_LEFT_TO_FILL=20
ADAPTIVE_OVERLAY_HIGH_MAX_ORDER_AGE_SECONDS=0
ADAPTIVE_OVERLAY_HIGH_MIN_BTC_MOVE_BPS=3
ADAPTIVE_OVERLAY_HIGH_MAX_BTC_REVERSAL_BPS=2
ADAPTIVE_OVERLAY_DEEP_ENABLED=true
ADAPTIVE_OVERLAY_DEEP_MIN_ENTRY_PRICE=0.03
ADAPTIVE_OVERLAY_DEEP_MAX_ENTRY_PRICE=0.10
# Marketable BUY orders require at least 1 USDC; 1.01 leaves rounding headroom.
ADAPTIVE_OVERLAY_DEEP_ORDER_USDC=1.01
ADAPTIVE_OVERLAY_DEEP_MAX_USDC_PER_LEG=1.01
ADAPTIVE_OVERLAY_DEEP_SCORE_THRESHOLD=0.20
ADAPTIVE_OVERLAY_DEEP_MIN_DISCOUNT=0.05
ADAPTIVE_OVERLAY_DEEP_TAKE_PROFIT_PRICE=0.05
ADAPTIVE_OVERLAY_DEEP_STOP_LOSS_PCT=0.50
ADAPTIVE_OVERLAY_DEEP_MIN_SECONDS_LEFT_TO_OPEN=60
ADAPTIVE_OVERLAY_DEEP_MAX_SECONDS_LEFT_TO_OPEN=240
ADAPTIVE_OVERLAY_DEEP_FORCE_EXIT_SECONDS_LEFT=30
ADAPTIVE_OVERLAY_DEEP_VOL_PER_INTERVAL=0.0015
ADAPTIVE_OVERLAY_CANCEL_SECONDS_BEFORE_END=5
ADAPTIVE_OVERLAY_EVALUATION_INTERVAL_MS=250
ADAPTIVE_OVERLAY_ORDER_POLL_INTERVAL_MS=500
ADAPTIVE_OVERLAY_MARKET_LOG_INTERVAL_MS=1000
ADAPTIVE_OVERLAY_ORDER_RETRY_SECONDS=5
ADAPTIVE_OVERLAY_MARKET_DATA_STALE_SECONDS=30
ADAPTIVE_OVERLAY_RECORD_ENABLED=true
ADAPTIVE_OVERLAY_RECORD_FILE=data/btc5m-adaptive-overlay-live.csv
# Backtest only: true enables deep-rebound in both range and non-range cycles.
ADAPTIVE_OVERLAY_DEEP_IN_RANGE=true
# Optional common overrides:
# ADAPTIVE_OVERLAY_MARKET=btc
# ADAPTIVE_OVERLAY_INTERVAL_MINUTES=5
# ADAPTIVE_OVERLAY_TICK_SIZE=0.01
# ADAPTIVE_OVERLAY_NEG_RISK=false
# ADAPTIVE_OVERLAY_BTC_PRICE_REFRESH_MS=250
# ADAPTIVE_OVERLAY_BTC_PRICE_MAX_STALE_MS=10000
# ADAPTIVE_OVERLAY_BTC_PRICE_URLS=https://...

# --- Extreme 0.20 Rebound Backtest Strategy ---
# Opens only while at least two minutes remain, then sells at fill + 0.05.
EXTREME_020_REBOUND_ENTRY_THRESHOLD=0.18
# 0 holds every fill to settlement; current samples outperform fixed take-profit.
EXTREME_020_REBOUND_TAKE_PROFIT_DELTA=0
EXTREME_020_REBOUND_ORDER_USDC=1.01
EXTREME_020_REBOUND_MIN_SECONDS_LEFT_TO_OPEN=120
EXTREME_020_REBOUND_MAX_SECONDS_LEFT_TO_OPEN=300
# Price/time stops are disabled: historical rebounds often dip first.
EXTREME_020_REBOUND_STOP_LOSS_PCT=0
EXTREME_020_REBOUND_MAX_HOLD_SECONDS=0
EXTREME_020_REBOUND_FORCE_EXIT_SECONDS_LEFT=0

# --- Final 30-Second High-Probability Backtest Strategy ---
FINAL_30_HIGH_TRIGGER_PRICE=0.85
FINAL_30_HIGH_EARLY_TRIGGER_PRICE=0.90
FINAL_30_HIGH_MAX_ENTRY_PRICE=0.90
# Two shares use 1.70-1.80 USDC across the default 0.85-0.90 entry band.
FINAL_30_HIGH_ORDER_SHARES=2
# After entry, buy the opposite leg only when both legs cost no more than this total.
FINAL_30_HEDGED_MAX_PAIR_COST=0.95
# Hold winners to settlement; exit when the bid falls ten points below entry.
FINAL_30_MANAGED_TRIGGER_PRICE=0.85
FINAL_30_MANAGED_EARLY_TRIGGER_PRICE=0.90
FINAL_30_MANAGED_MAX_ENTRY_PRICE=0.90
FINAL_30_MANAGED_ORDER_SHARES=2
FINAL_30_MANAGED_MIN_SECONDS_LEFT_TO_OPEN=0
FINAL_30_MANAGED_MAX_SECONDS_LEFT_TO_OPEN=30
FINAL_30_MANAGED_EARLY_MAX_SECONDS_LEFT_TO_OPEN=30
FINAL_30_MANAGED_TAKE_PROFIT_DELTA=0
FINAL_30_MANAGED_STOP_LOSS_DELTA=0.10
FINAL_30_MANAGED_STOP_MIN_BTC_REVERSAL_BPS=2
FINAL_30_MANAGED_STOP_CONFIRM_SECONDS=2
# 999 disables the open-price proximity filter; lower values require BTC to be near the strike.
FINAL_30_MANAGED_STOP_MAX_DIRECTIONAL_MARGIN_BPS=999
FINAL_30_MANAGED_DRY_RUN=true
FINAL_30_MANAGED_EVALUATION_INTERVAL_MS=100
FINAL_30_MANAGED_ORDER_POLL_INTERVAL_MS=250
FINAL_30_MANAGED_MARKET_LOG_INTERVAL_MS=1000
FINAL_30_MANAGED_RECORD_INTERVAL_MS=1000
FINAL_30_MANAGED_RECORD_ENABLED=true
FINAL_30_MANAGED_RECORD_FILE=data/btc5m-final-30-managed-live.csv
FINAL_30_HIGH_MIN_SECONDS_LEFT_TO_OPEN=0
FINAL_30_HIGH_MAX_SECONDS_LEFT_TO_OPEN=30
# Equal to 30 by default, disabling the earlier tier.
FINAL_30_HIGH_EARLY_MAX_SECONDS_LEFT_TO_OPEN=30
FINAL_30_HIGH_DRY_RUN=true
FINAL_30_HIGH_EVALUATION_INTERVAL_MS=100
FINAL_30_HIGH_ORDER_POLL_INTERVAL_MS=250
FINAL_30_HIGH_MARKET_LOG_INTERVAL_MS=1000
FINAL_30_HIGH_RECORD_INTERVAL_MS=1000
FINAL_30_HIGH_RECORD_ENABLED=true
FINAL_30_HIGH_RECORD_FILE=data/btc5m-final-30-high-live.csv
# Optional common overrides:
# FINAL_30_HIGH_MARKET=btc
# FINAL_30_HIGH_INTERVAL_MINUTES=5
# FINAL_30_HIGH_TICK_SIZE=0.01
# FINAL_30_HIGH_NEG_RISK=false
# FINAL_30_HIGH_BTC_PRICE_REFRESH_MS=250
# FINAL_30_HIGH_BTC_PRICE_MAX_STALE_MS=10000
# FINAL_30_HIGH_BTC_PRICE_URLS=https://...
# Optional BTC source override, separated by | or comma:
# TREND_PULLBACK_BTC_PRICE_URLS=https://api.exchange.coinbase.com/products/BTC-USD/ticker|https://api.kraken.com/0/public/Ticker?pair=XBTUSD
# Optional common overrides:
# TREND_PULLBACK_MARKET=btc
# TREND_PULLBACK_INTERVAL_MINUTES=5
# TREND_PULLBACK_TICK_SIZE=0.01
# TREND_PULLBACK_NEG_RISK=false
# TREND_PULLBACK_CANCEL_SECONDS_BEFORE_END=5
# TREND_PULLBACK_BTC_PRICE_REFRESH_MS=1000
# TREND_PULLBACK_BTC_PRICE_MAX_STALE_MS=10000

# --- Hybrid Strategy: npm run btc5m:hybrid ---
HYBRID_DRY_RUN=true
HYBRID_VOL_PER_INTERVAL=0.0006
HYBRID_MIN_EDGE=0.10
HYBRID_EDGE_MIN_MOVE_BPS=0
HYBRID_EDGE_MIN_ELAPSED_SECONDS=0
HYBRID_ORDER_USDC=3
HYBRID_MAX_USDC_PER_LEG=5
HYBRID_MAX_PRICE=0.85
HYBRID_RANGE_PRICE_X=0.35
HYBRID_RANGE_USDC_PER_LEG=3
HYBRID_LOOKBACK_SECONDS=60
HYBRID_OSC_THRESHOLD=2
HYBRID_RANGE_THRESHOLD=0.25
HYBRID_TREND_THRESHOLD=0.10
# Optional common overrides:
# HYBRID_MARKET=btc
# HYBRID_INTERVAL_MINUTES=5
# HYBRID_TICK_SIZE=0.01
# HYBRID_NEG_RISK=false
# HYBRID_MIN_SECONDS_LEFT_TO_TRADE=30
# HYBRID_CANCEL_SECONDS_BEFORE_END=5
# HYBRID_BTC_PRICE_REFRESH_MS=1000
# HYBRID_BTC_PRICE_MAX_STALE_MS=10000

# --- Range-Arb Strategy: npm run btc5m:range-arb ---
RANGE_ARB_DRY_RUN=true
RANGE_ARB_PRICE_X=0.40                # Must be below 0.5
RANGE_ARB_USDC_PER_LEG=5
RANGE_ARB_MIN_SECONDS_LEFT_TO_OPEN=60
RANGE_ARB_REQUIRE_AMPLITUDE=false
RANGE_ARB_AMPLITUDE_LOOKBACK_SECONDS=120
RANGE_ARB_AMPLITUDE_BUFFER=0.03
# Optional common overrides:
# RANGE_ARB_MARKET=btc
# RANGE_ARB_INTERVAL_MINUTES=5
# RANGE_ARB_TICK_SIZE=0.01
# RANGE_ARB_NEG_RISK=false
# RANGE_ARB_CANCEL_SECONDS_BEFORE_END=8

# --- Market-Maker Strategy: npm run btc5m:market-maker ---
MM_DRY_RUN=true
MM_QUOTE_SHARES=5
MM_MAX_USDC_PER_LEG=0                 # 0 = unlimited per leg
MM_MAX_INVENTORY_SHARES=30
MM_QUOTE_SPREAD=0.06
MM_MIN_LOCKED_EDGE=0.02
MM_INVENTORY_SKEW_PER_SHARE=0.002
MM_REQUOTE_THRESHOLD=0.01
MM_MIN_SECONDS_LEFT_TO_QUOTE=45
MM_QUOTE_INTERVAL_MS=1000
MM_POLL_INTERVAL_MS=2000
MM_ENABLE_SELL_EXCESS=true
# Optional common overrides:
# MM_MARKET=btc
# MM_INTERVAL_MINUTES=5
# MM_TICK_SIZE=0.01
# MM_NEG_RISK=false
# MM_CANCEL_SECONDS_BEFORE_END=8

# =============================================================================
# 4. Research tools: backtest and collector
# =============================================================================

# --- Backtest: npm run backtest:btc5m ---
# Supported strategies: edge, managed-edge, adaptive-edge, trend-pullback,
# range-arb, market-maker, hybrid
# and btc5m:* aliases.
BACKTEST_STRATEGY=edge
BACKTEST_CSV=
BACKTEST_TRADES_OUT=logs/backtest-btc5m-trades.csv
BACKTEST_INTERVAL_MINUTES=5
BACKTEST_VOL_PER_INTERVAL=0.0015
BACKTEST_MIN_EDGE=0.03
BACKTEST_EDGE_MIN_MOVE_BPS=0
BACKTEST_EDGE_MIN_ELAPSED_SECONDS=0
BACKTEST_ORDER_USDC=5
BACKTEST_MAX_USDC_PER_LEG=10
BACKTEST_MIN_SECONDS_LEFT=10
BACKTEST_MAX_PRICE=0.98

# --- History collector: npm run collect:btc5m-history ---
# Set duration to 0 to run forever.
COLLECT_MARKET=btc
COLLECT_INTERVAL_MINUTES=5
COLLECT_DURATION_MINUTES=60
COLLECT_SAMPLE_MS=1000
COLLECT_OUT_DIR=data
COLLECT_OUT_FILE=btc5m-history.csv
# Polymarket-only by default. Enable only if you want external BTC/open prices in CSV.
COLLECT_BTC_PRICE_ENABLED=false
# Multiple external BTC price sources, tried left-to-right when enabled. Separate with |.
COLLECT_BTC_PRICE_URLS=https://api.binance.com/api/v3/ticker/price?symbol=BTCUSDT|https://api.exchange.coinbase.com/products/BTC-USD/ticker|https://api.kraken.com/0/public/Ticker?pair=XBTUSD|https://www.okx.com/api/v5/market/ticker?instId=BTC-USDT
